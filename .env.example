# ==============================================================================
# RefillMap Backend Environment Variables Template
# Copy this file to .env and configure your local/production settings.
# NEVER commit real passwords or production secret keys to version control.
# ==============================================================================

# Server Port
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=refillmap_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_secure_password
DB_URL=jdbc:postgresql://localhost:5432/refillmap_db

# Security & JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
